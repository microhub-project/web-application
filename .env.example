# IMPORTANTE: CASO NÃO TENHA AS CREDENCIAIS NECESSÁRIAS, PERGUNTE AO TIME DE DESENVOLVIMENTO DO PROJETO!
AMBIENTE_PROCESSO=

# Configurações de conexão com o banco de dados
DB_HOST= # host do db
DB_DATABASE= # nome do db
DB_USER= # usuário da aplicação
DB_PASSWORD= # senha da aplicação
DB_PORT= # porta do db

# Configurações do servidor de aplicação
APP_PORT= # porta da aplicação
APP_HOST= # host da aplicação

SMTP_USER= # email de envio
SMTP_PASS= # senha de app do email de envio

SECRET_KEY= # chave secreta para criptografar senhas no db
# importante: caso sua senha contenha caracteres especiais, insira-a entre 'aspas'
# IMPORTANTE: CASO NÃO TENHA AS CREDENCIAIS NECESSÁRIAS, PERGUNTE AO TIME DE DESENVOLVIMENTO DO PROJETO!
